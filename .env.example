# Copy this file to .env and fill in your own values.
# CANVAS_BASE_URL: your school's Canvas address (what you see in the browser when logged in).
# CANVAS_API_TOKEN: generate at Canvas -> Account -> Settings -> Approved Integrations -> + New Access Token.
# Treat the token like your Canvas password: it stays in this local file and is never shared or committed.
CANVAS_BASE_URL=https://canvas.txstate.edu
CANVAS_API_TOKEN=paste-your-token-here
